<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<!-- Ventana principal: menú lateral + área central donde se abre cada pantalla -->
<BorderPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectofinal.controller.ShellController">

    <fx:define>
        <ToggleGroup fx:id="grupoNavegacion" />
        <ToggleGroup fx:id="grupoModo" />
    </fx:define>

    <left>
        <VBox styleClass="sidebar" prefWidth="236.0" minWidth="236.0">
            <TextFlow styleClass="marca">
                <Text styleClass="titulo" text="Sole" style="-fx-font-size: 34px;" />
                <Text styleClass="titulo-italico" text="a" style="-fx-font-size: 34px;" />
            </TextFlow>

            <HBox styleClass="segmentado" maxWidth="Infinity">
                <ToggleButton fx:id="tgNutricion" text="Nutrición" toggleGroup="$grupoModo"
                              onAction="#handleModoNutricion" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                <ToggleButton fx:id="tgGimnasio" text="Gimnasio" toggleGroup="$grupoModo"
                              onAction="#handleModoGimnasio" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
            </HBox>

            <Region minHeight="10.0" />

            <ToggleButton fx:id="navInicio" text="Inicio" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                          onAction="#irInicio" maxWidth="Infinity">
                <graphic><Circle radius="3.5" styleClass="punto" /></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navPerfil" text="Perfil físico" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                          onAction="#irPerfil" maxWidth="Infinity">
                <graphic><Circle radius="3.5" styleClass="punto" /></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navObjetivo" text="Objetivo" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                          onAction="#irObjetivo" maxWidth="Infinity">
                <graphic><Circle radius="3.5" styleClass="punto" /></graphic>
            </ToggleButton>

            <Label text="Nutrición" styleClass="nav-grupo" />
            <ToggleButton fx:id="navRequerimiento" text="Requerimiento" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                          onAction="#irRequerimiento" maxWidth="Infinity">
                <graphic><Circle radius="3.5" styleClass="punto, nutricion" /></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navRecetas" text="Recetas" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                          onAction="#irRecetas" maxWidth="Infinity">
                <graphic><Circle radius="3.5" styleClass="punto, nutricion" /></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navPlan" text="Plan semanal" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                          onAction="#irPlan" maxWidth="Infinity">
                <graphic><Circle radius="3.5" styleClass="punto, nutricion" /></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navSuper" text="Lista del súper" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                          onAction="#irSuper" maxWidth="Infinity">
                <graphic><Circle radius="3.5" styleClass="punto, nutricion" /></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navConsumo" text="Consumo" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                          onAction="#irConsumo" maxWidth="Infinity">
                <graphic><Circle radius="3.5" styleClass="punto, nutricion" /></graphic>
            </ToggleButton>

            <VBox fx:id="grupoGimnasio" spacing="2.0">
                <Label text="Gimnasio" styleClass="nav-grupo" />
                <ToggleButton fx:id="navRutina" text="Rutina" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                              onAction="#irRutina" maxWidth="Infinity">
                    <graphic><Circle radius="3.5" styleClass="punto, gimnasio" /></graphic>
                </ToggleButton>
                <ToggleButton fx:id="navEjercicios" text="Ejercicios" styleClass="nav-item" toggleGroup="$grupoNavegacion"
                              onAction="#irEjercicios" maxWidth="Infinity">
                    <graphic><Circle radius="3.5" styleClass="punto, gimnasio" /></graphic>
                </ToggleButton>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <VBox styleClass="usuario">
                <Label fx:id="lblUsuario" styleClass="dato" text="" />
                <Label fx:id="lblDetalleUsuario" styleClass="nota" text="" />
                <Button text="Cerrar sesión" styleClass="fantasma" onAction="#handleCerrarSesion"
                        style="-fx-padding: 6 0 0 0; -fx-background-color: transparent;" />
            </VBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contenido" styleClass="contenido" />
    </center>
</BorderPane>
