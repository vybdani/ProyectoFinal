<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox styleClass="pagina" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinal.controller.ListaSuperController">
    <VBox spacing="6.0">
        <TextFlow>
            <Text styleClass="titulo" text="Lista del " />
            <Text styleClass="titulo-italico" text="súper." />
        </TextFlow>
        <Label text="Se llena desde el plan semanal con «Enviar ingredientes a la lista», o agrega productos a mano."
               styleClass="subtitulo" wrapText="true" />
    </VBox>

    <HBox styleClass="tarjeta" spacing="10.0" alignment="BOTTOM_LEFT">
        <VBox spacing="6.0" HBox.hgrow="ALWAYS">
            <Label text="Producto" styleClass="etiqueta" />
            <TextField fx:id="txtProducto" promptText="Ej. Pechuga de pollo" />
        </VBox>
        <VBox spacing="6.0">
            <Label text="Cantidad" styleClass="etiqueta" />
            <TextField fx:id="txtCantidad" promptText="Ej. 2" prefWidth="100.0" />
        </VBox>
        <VBox spacing="6.0">
            <Label text="Unidad" styleClass="etiqueta" />
            <ComboBox fx:id="cmbUnidad" promptText="Unidad" prefWidth="140.0" />
        </VBox>
        <Button text="Agregar" styleClass="primario" onAction="#agregarProducto" defaultButton="true" />
    </HBox>

    <TableView fx:id="tblListaSuper" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="240.0" />
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100.0" />
            <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="110.0" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Marcar como comprado" onAction="#marcarComprado" />
        <Button text="Vista previa" onAction="#handleVistaPrevia" />
        <Button text="Exportar PDF" onAction="#handleExportarPdf" />
        <Button text="Exportar Excel" onAction="#handleExportarExcel" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Eliminar" styleClass="peligro" onAction="#eliminarProducto" />
    </HBox>
</VBox>
