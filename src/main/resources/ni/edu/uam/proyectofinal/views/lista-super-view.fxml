<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="14.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinal.controller.ListaSuperController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Lista del Súper">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <Label text="Puedes llenarla desde el Plan semanal (botón &quot;Enviar Ingredientes a Lista del Súper&quot;) o agregar productos a mano."
           wrapText="true" style="-fx-text-fill: #666666;" />

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="txtProducto" promptText="Producto" prefWidth="220.0" />
        <TextField fx:id="txtCantidad" promptText="Cantidad" prefWidth="90.0" />
        <ComboBox fx:id="cmbUnidad" promptText="Unidad" prefWidth="130.0" />
        <Button text="Agregar" onAction="#agregarProducto"
                style="-fx-background-color: #4caf50; -fx-text-fill: white;" />
    </HBox>

    <TableView fx:id="tblListaSuper" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="240.0" />
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="100.0" />
            <TableColumn fx:id="colUnidad" text="Unidad" prefWidth="110.0" />
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="120.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox spacing="10.0">
        <Button text="Marcar / desmarcar comprado" onAction="#marcarComprado" />
        <Button text="Eliminar" onAction="#eliminarProducto"
                style="-fx-background-color: #f44336; -fx-text-fill: white;" />
        <Button text="Volver" onAction="#handleVolver" />
    </HBox>
</VBox>
