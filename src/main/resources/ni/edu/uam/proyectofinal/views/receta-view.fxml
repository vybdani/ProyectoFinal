<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox styleClass="pagina" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinal.controller.RecetaController">
    <HBox alignment="BOTTOM_LEFT">
        <VBox spacing="6.0">
            <TextFlow>
                <Text styleClass="titulo" text="Tus " />
                <Text styleClass="titulo-italico" text="recetas." />
            </TextFlow>
            <Label text="Crea recetas con sus ingredientes; Solea suma las calorías y los macros." styleClass="subtitulo" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Resumen calórico" onAction="#handleVerResumenHQL" />
    </HBox>

    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <!-- Editor de receta -->
        <ScrollPane fitToWidth="true" prefWidth="460.0" minWidth="420.0">
            <VBox styleClass="tarjeta" spacing="8.0">
                <Label text="Nombre de la receta" styleClass="etiqueta" />
                <TextField fx:id="txtNombreReceta" promptText="Ej. Pollo con arroz y aguacate" />
                <HBox spacing="10.0">
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Tiempo de comida" styleClass="etiqueta" />
                        <ComboBox fx:id="cmbTipoComida" promptText="Selecciona" maxWidth="Infinity" />
                    </VBox>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <Label text="Minutos de preparación" styleClass="etiqueta" />
                        <TextField fx:id="txtTiempoPrep" promptText="Ej. 20" />
                    </VBox>
                </HBox>
                <Label text="Preparación" styleClass="etiqueta" />
                <TextArea fx:id="txtDescripcion" promptText="Pasos de la preparación" prefRowCount="3" wrapText="true" />

                <Region minHeight="6.0" />
                <Label text="Ingredientes" styleClass="seccion" style="-fx-font-size: 22px;" />
                <HBox spacing="8.0">
                    <ComboBox fx:id="cmbAlimento" promptText="Alimento" maxWidth="Infinity" HBox.hgrow="ALWAYS" />
                    <Button text="Internet" onAction="#handleBuscarEnInternet" />
                    <TextField fx:id="txtGramos" promptText="Gramos" prefWidth="86.0" />
                </HBox>
                <HBox spacing="8.0">
                    <Button text="Agregar ingrediente" onAction="#handleAgregarIngrediente" />
                    <Button text="Quitar" styleClass="fantasma" onAction="#handleQuitarIngrediente" />
                </HBox>
                <TableView fx:id="tblIngredientes" prefHeight="170.0">
                    <columns>
                        <TableColumn fx:id="colIngAlimento" text="Alimento" prefWidth="200.0" />
                        <TableColumn fx:id="colIngGramos" text="Gramos" prefWidth="80.0" />
                        <TableColumn fx:id="colIngKcal" text="Calorías" prefWidth="90.0" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
                <Label fx:id="lblTotalesReceta" text="Total de la receta: 0 kcal" styleClass="resumen" wrapText="true" />

                <Region minHeight="4.0" />
                <HBox spacing="8.0">
                    <Button text="Guardar receta" styleClass="primario" onAction="#handleGuardarReceta" />
                    <Button text="Limpiar" onAction="#handleLimpiar" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button text="Eliminar" styleClass="peligro" onAction="#handleEliminarReceta" />
                </HBox>
            </VBox>
        </ScrollPane>

        <!-- Recetas guardadas -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <Label text="Recetas guardadas" styleClass="seccion" style="-fx-font-size: 22px;" />
            <TableView fx:id="tblRecetas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colRecNombre" text="Receta" prefWidth="170.0" />
                    <TableColumn fx:id="colRecTipo" text="Tiempo" prefWidth="90.0" />
                    <TableColumn fx:id="colRecKcal" text="Calorías" prefWidth="80.0" />
                    <TableColumn fx:id="colRecMacros" text="Macronutrientes" prefWidth="170.0" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </HBox>
</VBox>
