<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox styleClass="pagina" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinal.controller.PlanSemanalController">
    <VBox spacing="6.0">
        <TextFlow>
            <Text styleClass="titulo" text="Tu plan " />
            <Text styleClass="titulo-italico" text="semanal." />
        </TextFlow>
        <Label fx:id="lblInfoPlan" text="Aún no tienes un plan semanal generado." styleClass="subtitulo" wrapText="true" />
    </VBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Button text="Generar plan semanal" styleClass="primario" onAction="#handleGenerarPlan" />
        <Button text="Enviar ingredientes a la lista" onAction="#handleEnviarListaSuper" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Día" styleClass="etiqueta" />
        <ComboBox fx:id="cmbFiltroDia" onAction="#handleFiltrarDia" prefWidth="160.0" />
    </HBox>

    <TableView fx:id="tblPlanSemanal" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDia" text="Día" prefWidth="110.0" />
            <TableColumn fx:id="colTiempo" text="Comida" prefWidth="120.0" />
            <TableColumn fx:id="colReceta" text="Receta" prefWidth="250.0" />
            <TableColumn fx:id="colCalorias" text="Calorías" prefWidth="100.0" />
            <TableColumn fx:id="colMacros" text="Macronutrientes" prefWidth="220.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
