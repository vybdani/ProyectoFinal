<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="22.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinal.controller.MenuPrincipalController">
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <Label fx:id="lblBienvenida" text="Bienvenido/a a NutriFit">
        <font>
            <Font name="System Bold" size="22.0" />
        </font>
    </Label>

    <Label text="Selecciona el modo de trabajo:" />

    <HBox spacing="20.0" alignment="CENTER">
        <VBox spacing="6.0" alignment="CENTER">
            <Button text="🥗 Modo Nutrición" onAction="#handleModoNutricion" prefWidth="200.0" prefHeight="60.0"
                    style="-fx-background-color: #4caf50; -fx-text-fill: white; -fx-font-size: 14px;" />
            <Label text="Bajar, mantener o subir de peso" style="-fx-text-fill: #666666;" />
        </VBox>

        <VBox spacing="6.0" alignment="CENTER">
            <Button text="🏋 Modo Gimnasio" onAction="#handleModoGimnasio" prefWidth="200.0" prefHeight="60.0"
                    style="-fx-background-color: #ff9800; -fx-text-fill: white; -fx-font-size: 14px;" />
            <Label text="Volumen muscular o definición" style="-fx-text-fill: #666666;" />
        </VBox>
    </HBox>

    <!-- Botón para consumir la API REST de NutriFit -->
    <Button text="💡 Consejo Nutricional del Día (API REST)" onAction="#handleConsultarApiConsejo"
            prefWidth="320.0" prefHeight="38.0"
            style="-fx-background-color: #2196f3; -fx-text-fill: white; -fx-font-weight: bold;" />

    <HBox spacing="15.0" alignment="CENTER">
        <Button text="Editar perfil físico" onAction="#handleEditarPerfil" />
        <Button text="Cerrar sesión" onAction="#handleCerrarSesion" />
    </HBox>
</VBox>
