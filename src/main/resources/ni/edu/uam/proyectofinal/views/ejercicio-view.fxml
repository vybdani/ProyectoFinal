<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox styleClass="pagina" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinal.controller.EjercicioController">
    <HBox alignment="BOTTOM_LEFT">
        <VBox spacing="6.0">
            <TextFlow>
                <Text styleClass="titulo" text="Catálogo de " />
                <Text styleClass="titulo-italico" text="ejercicios." />
            </TextFlow>
            <Label text="Los ejercicios que usa el generador de rutinas, por grupo muscular." styleClass="subtitulo" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Volver a la rutina" onAction="#handleVolver" />
    </HBox>

    <HBox spacing="18.0" VBox.vgrow="ALWAYS">
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Grupo muscular" styleClass="etiqueta" />
                <ComboBox fx:id="cmbFiltroGrupo" prefWidth="180.0" />
            </HBox>
            <TableView fx:id="tblEjercicios" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombre" text="Ejercicio" prefWidth="220.0" />
                    <TableColumn fx:id="colGrupo" text="Grupo" prefWidth="110.0" />
                    <TableColumn fx:id="colEquipo" text="Equipo" prefWidth="130.0" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>

        <VBox styleClass="tarjeta" spacing="8.0" prefWidth="330.0" minWidth="300.0">
            <Label fx:id="lblModo" text="Nuevo ejercicio" styleClass="seccion" style="-fx-font-size: 22px;" wrapText="true" />
            <Label text="Nombre" styleClass="etiqueta" />
            <TextField fx:id="txtNombre" promptText="Ej. Press de banca" />
            <Label text="Grupo muscular" styleClass="etiqueta" />
            <ComboBox fx:id="cmbGrupo" promptText="Selecciona" maxWidth="Infinity" />
            <Label text="Equipo" styleClass="etiqueta" />
            <TextField fx:id="txtEquipo" promptText="Ej. Mancuernas" />
            <Label text="Descripción o técnica" styleClass="etiqueta" />
            <TextArea fx:id="txtDescripcion" prefRowCount="4" wrapText="true" />
            <Region VBox.vgrow="ALWAYS" />
            <HBox spacing="8.0">
                <Button text="Guardar" styleClass="primario" onAction="#handleGuardar" />
                <Button text="Nuevo" onAction="#handleNuevo" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Eliminar" styleClass="peligro" onAction="#handleEliminar" />
            </HBox>
        </VBox>
    </HBox>
</VBox>
