<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinal.controller.RutinaController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="🏋 Rutina de Gimnasio">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <Label fx:id="lblObjetivo" text="" style="-fx-font-weight: bold;" />

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Días por semana:" />
        <ComboBox fx:id="cmbDias" prefWidth="80.0" />
        <Button text="⚡ Generar rutina" onAction="#handleGenerar"
                style="-fx-background-color: #ff9800; -fx-text-fill: white;" />
        <Button text="📚 Catálogo de ejercicios" onAction="#handleEjercicios" />
    </HBox>

    <Label fx:id="lblInfoRutina" text="" wrapText="true" />

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Ver:" />
        <ComboBox fx:id="cmbFiltroDia" prefWidth="200.0" />
        <Label text="Nombre:" />
        <TextField fx:id="txtNombreRutina" prefWidth="260.0" />
        <Button text="Renombrar" onAction="#handleRenombrar" />
    </HBox>

    <TableView fx:id="tblRutina" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDia" text="Día" prefWidth="150.0" />
            <TableColumn fx:id="colEjercicio" text="Ejercicio" prefWidth="230.0" />
            <TableColumn fx:id="colGrupo" text="Grupo muscular" prefWidth="120.0" />
            <TableColumn fx:id="colSeries" text="Series" prefWidth="70.0" />
            <TableColumn fx:id="colRepeticiones" text="Repeticiones" prefWidth="100.0" />
            <TableColumn fx:id="colDescanso" text="Descanso" prefWidth="80.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblDetalle" text="" wrapText="true" style="-fx-text-fill: #555555;" />
    <Label fx:id="lblResumen" text="" wrapText="true" style="-fx-font-weight: bold;" />

    <HBox spacing="10.0">
        <Button text="Eliminar rutina" onAction="#handleEliminar"
                style="-fx-background-color: #f44336; -fx-text-fill: white;" />
        <Button text="Exportar PDF" onAction="#handleExportarPdf" />
        <Button text="Volver" onAction="#handleVolver" />
    </HBox>
</VBox>
