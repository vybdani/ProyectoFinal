<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<VBox styleClass="pagina" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.proyectofinal.controller.RutinaController">
    <HBox alignment="BOTTOM_LEFT">
        <VBox spacing="6.0">
            <TextFlow>
                <Text styleClass="titulo" text="Tu rutina de " />
                <Text styleClass="titulo-italico" text="gimnasio." />
            </TextFlow>
            <Label fx:id="lblObjetivo" text="" styleClass="subtitulo" />
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Catálogo de ejercicios" onAction="#handleEjercicios" />
    </HBox>

    <!-- Generar -->
    <HBox styleClass="tarjeta" spacing="12.0" alignment="CENTER_LEFT">
        <Label text="Días por semana" styleClass="etiqueta" />
        <ComboBox fx:id="cmbDias" prefWidth="90.0" />
        <Button text="Generar rutina" styleClass="primario" onAction="#handleGenerar" />
        <Region HBox.hgrow="ALWAYS" />
        <Label fx:id="lblInfoRutina" text="" wrapText="true" styleClass="nota" maxWidth="420.0" />
    </HBox>

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Label text="Ver" styleClass="etiqueta" />
        <ComboBox fx:id="cmbFiltroDia" prefWidth="220.0" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Nombre" styleClass="etiqueta" />
        <TextField fx:id="txtNombreRutina" prefWidth="240.0" />
        <Button text="Renombrar" onAction="#handleRenombrar" />
    </HBox>

    <TableView fx:id="tblRutina" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colDia" text="Día" prefWidth="150.0" />
            <TableColumn fx:id="colEjercicio" text="Ejercicio" prefWidth="230.0" />
            <TableColumn fx:id="colGrupo" text="Grupo muscular" prefWidth="130.0" />
            <TableColumn fx:id="colSeries" text="Series" prefWidth="70.0" />
            <TableColumn fx:id="colRepeticiones" text="Repeticiones" prefWidth="110.0" />
            <TableColumn fx:id="colDescanso" text="Descanso" prefWidth="90.0" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <Label fx:id="lblDetalle" text="" wrapText="true" styleClass="texto-suave" />
    <Label fx:id="lblResumen" text="" wrapText="true" styleClass="resumen" />

    <HBox spacing="10.0">
        <Button text="Exportar PDF" onAction="#handleExportarPdf" />
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Eliminar rutina" styleClass="peligro" onAction="#handleEliminar" />
    </HBox>
</VBox>
