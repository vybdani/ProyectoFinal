<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<!-- Objetivo del modo actual (Nutrición o Gimnasio). El modo se cambia en el menú lateral. -->
<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectofinal.controller.ModoController">
    <VBox styleClass="pagina" alignment="TOP_CENTER">
        <VBox spacing="6.0" maxWidth="640.0">
            <TextFlow>
                <Text styleClass="titulo" text="¿Cuál es tu " />
                <Text styleClass="titulo-italico" text="objetivo?" />
            </TextFlow>
            <Label fx:id="lblTitulo" styleClass="subtitulo" text="" />
        </VBox>

        <VBox styleClass="tarjeta" spacing="14.0" maxWidth="640.0">
            <Label fx:id="lblObjetivoActual" styleClass="dato" text="" />
            <Label text="Mi objetivo" styleClass="etiqueta" />
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <ComboBox fx:id="cmbObjetivo" promptText="Selecciona tu objetivo" prefWidth="280.0" />
                <Button text="Guardar objetivo" styleClass="primario" onAction="#handleGuardarObjetivo" />
            </HBox>
            <Label fx:id="lblDescripcion" text="" wrapText="true" styleClass="texto-suave" />
        </VBox>

        <VBox spacing="8.0" maxWidth="640.0" minWidth="640.0">
            <Label text="Después de guardar tu objetivo, calcula tu requerimiento diario para actualizar tus calorías." styleClass="nota" wrapText="true" />
            <HBox>
                <Button text="Calcular requerimiento" onAction="#handleCalculo" />
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
