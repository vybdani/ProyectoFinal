<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ni.edu.uam.proyectofinal.controller.CalculoController">
    <VBox styleClass="pagina">
        <VBox spacing="6.0">
            <TextFlow>
                <Text styleClass="titulo" text="Tu requerimiento " />
                <Text styleClass="titulo-italico" text="diario." />
            </TextFlow>
            <Label fx:id="lblObjetivo" styleClass="subtitulo" text="" wrapText="true" />
        </VBox>

        <!-- Meta del día -->
        <HBox styleClass="tarjeta" style="-fx-padding: 22 0 22 0;">
            <VBox styleClass="celda-dato" spacing="6.0" HBox.hgrow="ALWAYS" prefWidth="300.0">
                <Label text="Calorías diarias" styleClass="etiqueta" />
                <Label fx:id="lblCalorias" text="—" styleClass="numero-grande" />
                <Label text="Tu meta para cada día" styleClass="nota" />
            </VBox>
            <VBox styleClass="celda-dato" spacing="6.0" HBox.hgrow="ALWAYS" prefWidth="180.0">
                <Label text="Proteínas" styleClass="etiqueta" />
                <Label fx:id="lblProteinas" text="—" styleClass="numero" />
            </VBox>
            <VBox styleClass="celda-dato" spacing="6.0" HBox.hgrow="ALWAYS" prefWidth="180.0">
                <Label text="Carbohidratos" styleClass="etiqueta" />
                <Label fx:id="lblCarbohidratos" text="—" styleClass="numero" />
            </VBox>
            <VBox styleClass="celda-dato, ultima" spacing="6.0" HBox.hgrow="ALWAYS" prefWidth="180.0">
                <Label text="Grasas" styleClass="etiqueta" />
                <Label fx:id="lblGrasas" text="—" styleClass="numero" />
            </VBox>
        </HBox>

        <HBox styleClass="tarjeta-suave" spacing="10.0" alignment="CENTER_LEFT" maxWidth="640.0">
            <Label text="Metabolismo basal (TMB)" styleClass="texto-suave" />
            <Label fx:id="lblTMB" text="—" styleClass="dato" />
        </HBox>

        <Label text="El cálculo usa tu perfil físico y el objetivo del modo actual." styleClass="nota" />

        <HBox spacing="10.0">
            <Button text="Calcular y guardar" styleClass="primario" onAction="#calcular" defaultButton="true" />
            <Button text="Exportar PDF" onAction="#handleExportarPdf" />
        </HBox>
    </VBox>
</ScrollPane>
