<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ReporteListaSuper"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              uuid="c1b72e8a-7845-42cf-9e6b-0c159048a101">

    <parameter name="TITULO" class="java.lang.String"/>
    <parameter name="USUARIO" class="java.lang.String"/>
    <parameter name="FECHA" class="java.lang.String"/>

    <field name="alimento" class="java.lang.String"/>
    <field name="cantidad" class="java.lang.Double"/>
    <field name="unidad" class="java.lang.String"/>
    <field name="comprado" class="java.lang.Boolean"/>

    <title>
        <band height="75">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="55" backcolor="#4CAF50" uuid="e812b1a1-9a72-4d1a-8c88-111111111111"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="10" width="300" height="35" forecolor="#FFFFFF" uuid="e812b1a1-9a72-4d1a-8c88-222222222222"/>
                <textElement verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[🛒 NutriFit - Lista del Súper]]></text>
            </staticText>
            <textField>
                <reportElement x="320" y="10" width="200" height="18" forecolor="#FFFFFF" uuid="e812b1a1-9a72-4d1a-8c88-333333333333"/>
                <textElement textAlignment="Right">
                    <font size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Usuario: " + ($P{USUARIO} != null ? $P{USUARIO} : "General")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="320" y="28" width="200" height="18" forecolor="#FFFFFF" uuid="e812b1a1-9a72-4d1a-8c88-444444444444"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Generado: " + ($P{FECHA} != null ? $P{FECHA} : "")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="535" height="22" backcolor="#E0E0E0" uuid="e812b1a1-9a72-4d1a-8c88-555555555555"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#BDBDBD"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="3" width="240" height="16" uuid="a1111111-1111-1111-1111-111111111111"/>
                <textElement verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Alimento / Ingrediente]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="3" width="90" height="16" uuid="a2222222-2222-2222-2222-222222222222"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Cantidad]]></text>
            </staticText>
            <staticText>
                <reportElement x="365" y="3" width="80" height="16" uuid="a3333333-3333-3333-3333-333333333333"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Unidad]]></text>
            </staticText>
            <staticText>
                <reportElement x="460" y="3" width="65" height="16" uuid="a4444444-4444-4444-4444-444444444444"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font isBold="true"/>
                </textElement>
                <text><![CDATA[Comprado]]></text>
            </staticText>
        </band>
