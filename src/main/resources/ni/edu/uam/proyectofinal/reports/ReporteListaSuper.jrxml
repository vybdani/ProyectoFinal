    <detail>
        <band height="22">
            <line>
                <reportElement x="0" y="21" width="535" height="1" forecolor="#EEEEEE" uuid="b1111111-1111-1111-1111-111111111111"/>
            </line>
            <textField textAdjust="StretchHeight">
                <reportElement x="10" y="2" width="240" height="16" uuid="b2222222-2222-2222-2222-222222222222"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{alimento} != null ? $F{alimento} : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="260" y="2" width="90" height="16" uuid="b3333333-3333-3333-3333-333333333333"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{cantidad} != null ? String.format("%.1f", $F{cantidad}) : "-"]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="365" y="2" width="80" height="16" uuid="b4444444-4444-4444-4444-444444444444"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{unidad} != null ? $F{unidad} : ""]]></textFieldExpression>
