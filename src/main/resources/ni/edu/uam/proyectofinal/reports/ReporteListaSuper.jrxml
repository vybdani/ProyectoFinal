            <textField>
                <reportElement x="460" y="2" width="65" height="16" uuid="b5555555-5555-5555-5555-555555555555"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[Boolean.TRUE.equals($F{comprado}) ? "✓ Sí" : "[ ] Pendiente"]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="30">
