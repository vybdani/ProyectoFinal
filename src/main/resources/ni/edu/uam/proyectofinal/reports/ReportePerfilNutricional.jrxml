<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ReportePerfilNutricional"
              pageWidth="595" pageHeight="842"
              columnWidth="535" leftMargin="30" rightMargin="30" topMargin="30" bottomMargin="30"
              uuid="89a14ff4-702b-4917-be8e-c7476811d348">

    <parameter name="NOMBRE_USUARIO" class="java.lang.String"/>
    <parameter name="CORREO" class="java.lang.String"/>
    <parameter name="PESO" class="java.lang.Double"/>
    <parameter name="ALTURA" class="java.lang.Double"/>
    <parameter name="EDAD" class="java.lang.Integer"/>
    <parameter name="SEXO" class="java.lang.String"/>
    <parameter name="OBJETIVO" class="java.lang.String"/>
    <parameter name="CALORIAS_OBJETIVO" class="java.lang.Integer"/>
    <parameter name="PROTEINAS_G" class="java.lang.Integer"/>
    <parameter name="CARBOHIDRATOS_G" class="java.lang.Integer"/>
    <parameter name="GRASAS_G" class="java.lang.Integer"/>
    <parameter name="FECHA" class="java.lang.String"/>

    <title>
        <band height="320">
            <!-- Encabezado Principal -->
            <rectangle>
                <reportElement x="0" y="0" width="535" height="60" backcolor="#5B6F00" uuid="f4e8595f-499f-4ab6-959e-60814a787200"/>
                <graphicElement><pen lineWidth="0.0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="10" width="340" height="40" mode="Opaque" forecolor="#FFFFFF" backcolor="#5B6F00" uuid="2d264a18-c7c9-42db-a59e-534b8a7d118d"/>
                <textElement verticalAlignment="Middle">
                    <font size="19" isBold="true"/>
                </textElement>
                <text><![CDATA[Solea - Ficha Nutricional]]></text>
            </staticText>
            <textField>
                <reportElement x="360" y="20" width="160" height="20" mode="Opaque" forecolor="#FFFFFF" backcolor="#5B6F00" uuid="94d5a04d-f563-4431-9b6f-ff3fbf580fef"/>
                <textElement textAlignment="Right" verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Fecha: " + ($P{FECHA} != null ? $P{FECHA} : "")]]></textFieldExpression>
            </textField>

            <!-- Sección Datos Personales -->
            <rectangle>
                <reportElement x="0" y="75" width="535" height="95" backcolor="#F7F5EE" uuid="3ed37bd9-e957-4c71-8146-afb73227442d"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#E4E0D5"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="82" width="200" height="18" forecolor="#5B6F00" uuid="a69148c0-7614-41e2-a3bc-ca9d7d3d4619"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Información del Usuario]]></text>
            </staticText>

            <textField>
                <reportElement x="15" y="105" width="240" height="16" uuid="cd5f530c-0a41-4937-b5d8-dc98073dfd28"/>
                <textFieldExpression><![CDATA["Nombre: " + ($P{NOMBRE_USUARIO} != null ? $P{NOMBRE_USUARIO} : "-")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="15" y="125" width="240" height="16" uuid="fd72686d-d0de-4621-93fd-063eff7adca3"/>
                <textFieldExpression><![CDATA["Correo: " + ($P{CORREO} != null ? $P{CORREO} : "-")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="15" y="145" width="240" height="16" uuid="f95a3c8c-1ad3-402b-8d30-6a49e60b7f6c"/>
                <textFieldExpression><![CDATA["Sexo: " + ($P{SEXO} != null ? $P{SEXO} : "-")]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="280" y="105" width="240" height="16" uuid="095c24c3-3f52-4f91-8675-2b8bab57c6b5"/>
                <textFieldExpression><![CDATA["Peso actual: " + ($P{PESO} != null ? new java.text.DecimalFormat("0.#").format($P{PESO}) + " kg" : "-")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="125" width="240" height="16" uuid="18179e8e-acdc-46ea-94ea-2676eb6b4e66"/>
                <textFieldExpression><![CDATA["Estatura: " + ($P{ALTURA} != null ? new java.text.DecimalFormat("0.#").format($P{ALTURA}) + " cm" : "-")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="280" y="145" width="240" height="16" uuid="1fb32b8a-9eb2-4d84-9a56-119196dfbf7e"/>
                <textFieldExpression><![CDATA["Edad: " + ($P{EDAD} != null ? $P{EDAD} + " años" : "-")]]></textFieldExpression>
            </textField>

            <!-- Sección Requerimiento Calórico y Macros -->
            <rectangle>
                <reportElement x="0" y="185" width="535" height="125" backcolor="#E7ECCF" uuid="53227d69-69f0-4f8f-827e-09b8e1f45379"/>
                <graphicElement><pen lineWidth="0.5" lineColor="#C9D39A"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="15" y="193" width="250" height="18" forecolor="#4A5A00" uuid="bf2b3b0e-6fcf-4ee6-9926-ea65c25fd570"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Meta y Requerimiento Diario]]></text>
            </staticText>

            <textField>
                <reportElement x="15" y="215" width="500" height="18" uuid="2a981502-ea57-4c2f-9069-3249b7985640"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Objetivo: " + ($P{OBJETIVO} != null ? $P{OBJETIVO} : "No definido")]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="15" y="240" width="240" height="24" forecolor="#4A5A00" uuid="34f3b444-4a89-45c7-9d03-7ebc7332de94"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🔥 Calorías Meta: " + ($P{CALORIAS_OBJETIVO} != null ? $P{CALORIAS_OBJETIVO} + " kcal" : "-")]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="15" y="275" width="160" height="20" uuid="7d34f320-b506-4c26-a045-415a6cb47d59"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🥩 Proteína: " + ($P{PROTEINAS_G} != null ? $P{PROTEINAS_G} + " g" : "-")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="185" y="275" width="160" height="20" uuid="65ca3ca3-bd45-48bd-b07a-f6280cab497d"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🍚 Carbohidratos: " + ($P{CARBOHIDRATOS_G} != null ? $P{CARBOHIDRATOS_G} + " g" : "-")]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="355" y="275" width="160" height="20" uuid="41f91752-742c-4bb1-9466-8bce14c712b3"/>
                <textElement>
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["🥑 Grasas: " + ($P{GRASAS_G} != null ? $P{GRASAS_G} + " g" : "-")]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <pageFooter>
        <band height="30">
            <textField>
                <reportElement x="350" y="8" width="175" height="15" forecolor="#6E6C64" uuid="d5a90ea9-c117-42bf-a439-7fb748355cf7"/>
                <textElement textAlignment="Right">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="10" y="8" width="335" height="15" forecolor="#6E6C64" uuid="cc025b2f-9f48-45ff-8722-d285d63f9a90"/>
